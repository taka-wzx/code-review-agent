FROM python:3.12-slim-bookworm

ARG DEBIAN_MIRROR=https://deb.debian.org
ARG PYPI_INDEX_URL=https://pypi.org/simple

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace/src \
    HOME=/tmp/repair-home \
    XDG_CONFIG_HOME=/tmp/repair-config

RUN case "$DEBIAN_MIRROR" in \
        https://deb.debian.org|https://mirrors.aliyun.com) ;; \
        *) echo "unsupported DEBIAN_MIRROR" >&2; exit 64 ;; \
    esac \
    && case "$PYPI_INDEX_URL" in \
        https://pypi.org/simple|https://mirrors.aliyun.com/pypi/simple/) ;; \
        *) echo "unsupported PYPI_INDEX_URL" >&2; exit 64 ;; \
    esac \
    && sed -i \
        -e "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" \
        -e "s|https://deb.debian.org|${DEBIAN_MIRROR}|g" \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install --yes --no-install-recommends git=1:2.39.5-0+deb12u2 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 65532 repair \
    && useradd --uid 65532 --gid 65532 --no-create-home --shell /usr/sbin/nologin repair \
    && mkdir -p /tmp/repair-home /tmp/repair-config \
    && chown -R 65532:65532 /tmp/repair-home /tmp/repair-config

COPY requirements.lock /tmp/requirements.lock
RUN python -m pip install --no-cache-dir --timeout 120 --retries 5 \
        --index-url "$PYPI_INDEX_URL" \
        --requirement /tmp/requirements.lock \
    && python -m pip install --no-cache-dir --timeout 120 --retries 5 \
        --index-url "$PYPI_INDEX_URL" \
        pytest==8.4.1 \
    && rm /tmp/requirements.lock

USER 65532:65532
WORKDIR /workspace

# DockerSandboxRunner always overrides this with an exact allowlisted argv.
ENTRYPOINT ["python"]
CMD ["-m", "unittest"]
