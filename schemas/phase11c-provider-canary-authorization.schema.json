{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 11C Gate B authorization candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase_id",
    "gate",
    "authorization_id",
    "authorization_sha256",
    "baseline",
    "binding_state",
    "real_provider_calls_enabled",
    "paid_calls_enabled",
    "authorization_window",
    "owners",
    "gate_b_bindings",
    "human_approvals"
  ],
  "properties": {
