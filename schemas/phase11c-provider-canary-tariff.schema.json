{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 11C provider tariff candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase_id",
    "tariff_manifest_sha256",
    "provider",
    "request_model_id",
    "currency",
    "integer_accounting_only",
    "tariff_review_state",
    "effective_date_state",
    "input_uncached_tariff_state",
    "input_cached_tariff_state",
    "output_tariff_state",
    "provider_data_use_policy_url",
    "provider_retention_policy_url",
    "policy_reviewed_at",
    "policy_evidence_sha256",
    "owner_policy_acceptance"
  ],
  "properties": {
    "schema_version": {"const": "phase11c-provider-canary-tariff/v1"},
    "phase_id": {"const": "phase11c-provider-canary-v1"},
    "tariff_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider": {"const": "glm"},
    "request_model_id": {"const": "glm-5.2"},
    "currency": {"const": "micro-CNY"},
    "integer_accounting_only": {"const": true},
    "tariff_review_state": {"const": "pending_current_review"},
    "effective_date_state": {"const": "pending_current_review"},
    "input_uncached_tariff_state": {"const": "pending_current_review"},
    "input_cached_tariff_state": {"const": "pending_current_review"},
    "output_tariff_state": {"const": "pending_current_review"},
    "provider_data_use_policy_url": {"const": "PENDING_CURRENT_REVIEW"},
    "provider_retention_policy_url": {"const": "PENDING_CURRENT_REVIEW"},
    "policy_reviewed_at": {"const": "PENDING_CURRENT_REVIEW"},
    "policy_evidence_sha256": {"const": "PENDING_CURRENT_REVIEW"},
    "owner_policy_acceptance": {"const": "PENDING_EXPLICIT_APPROVAL"}
  }
}
