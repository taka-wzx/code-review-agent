{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-agent.invalid/schemas/phase11d-canonical-manifest.schema.json",
  "title": "CRAG Phase 11D canonical manifest v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_sha256",
    "generated_at_utc",
    "baseline_sha",
    "local_master_at_start",
    "phase11c_facts",
    "auth004_boundary",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "crag.phase11d.canonical-manifest/v1alpha1"},
    "manifest_id": {"type": "string", "minLength": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "generated_at_utc": {"$ref": "#/$defs/utcSecond"},
    "baseline_sha": {"$ref": "#/$defs/gitSha"},
    "local_master_at_start": {"$ref": "#/$defs/gitSha"},
    "phase11c_facts": {"type": "object", "additionalProperties": true},
    "auth004_boundary": {"type": "object", "additionalProperties": true},
    "artifacts": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "utcSecond": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.(json|jsonl)$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
