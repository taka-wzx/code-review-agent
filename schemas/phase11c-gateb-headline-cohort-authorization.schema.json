{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crag.invalid/schemas/phase11c-gateb-headline-cohort-authorization.schema.json",
  "title": "Phase 11C deterministic synthetic headline cohort authorization v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_id", "payload_sha256"],
      "properties": {
        "stable_id": {"type": "string", "pattern": "^p11c-[0-9a-f]{32}$"},
        "payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "required": [
    "schema_version", "phase_id", "stage", "authorization_id", "authorization_status", "authorization_sha256",
    "execution_freeze_sha256",
    "executable_source_sha256", "executable_commit_sha", "source_tree_sha256", "source_archive_sha256",
    "dockerfile_sha256", "compose_sha256", "image_sha256", "deployment_sha256", "runtime_config_sha256",
    "runtime_identity_sha256", "aliyun_runtime_identity_sha256", "diagnostic_receipt_sha256",
    "diagnostic_authorization_sha256", "diagnostic_approval_binding_sha256", "cohort_manifest_sha256",
    "parent_gate_a_cohort_manifest_sha256", "auth004_nonoverlap_evidence_sha256", "auth004_intersection_count",
    "exact_headline_denominator", "target_bindings", "provider", "request_model_id", "api_surface",
    "endpoint_id", "endpoint_sha256", "request_protocol_sha256", "initial_request_template_sha256",
    "tool_schema_sha256", "synthetic_tool_result_sha256", "provider_policy_evidence_sha256",
    "provider_policy_accepted", "provider_tariff_evidence_sha256", "provider_tariff_manifest_sha256",
    "preflight_verdict_sha256", "credential_delivery_mode",
    "credential_fingerprint_sha256", "owner_account", "owner_reconfirmed", "kill_switch_bound",
    "authorization_window_start_utc", "authorization_window_end_utc", "headline_logical_call_cap",
    "headline_http_attempt_cap", "headline_input_token_cap", "headline_output_token_cap",
    "input_rate_microcny_per_million", "cached_input_rate_microcny_per_million",
    "output_rate_microcny_per_million", "headline_budget_microcny", "aggregate_remaining_microcny",
    "aggregate_remaining_after_reservation_microcny", "sdk_retries", "transport_retries", "concurrency",
    "stop_policy", "local_raw_retention", "stop_policy_sha256", "live_execution_enabled"
  ],
  "properties": {
    "schema_version": {"const": "phase11c-gateb-headline-cohort-authorization/v1"},
    "phase_id": {"const": "phase11c-gateb-headline-cohort-executor-v1"},
    "stage": {"const": "HEADLINE_COHORT"},
    "authorization_id": {"type": "string", "pattern": "^p11c-gateb-[0-9a-f]{32}$"},
    "authorization_status": {"const": "frozen_pending_exact_approval"},
    "authorization_sha256": {"$ref": "#/$defs/sha256"},
    "execution_freeze_sha256": {"$ref": "#/$defs/sha256"},
    "executable_source_sha256": {"$ref": "#/$defs/sha256"},
    "executable_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree_sha256": {"$ref": "#/$defs/sha256"},
    "source_archive_sha256": {"$ref": "#/$defs/sha256"},
    "dockerfile_sha256": {"$ref": "#/$defs/sha256"},
    "compose_sha256": {"$ref": "#/$defs/sha256"},
    "image_sha256": {"$ref": "#/$defs/sha256"},
    "deployment_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_config_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_identity_sha256": {"$ref": "#/$defs/sha256"},
    "aliyun_runtime_identity_sha256": {"$ref": "#/$defs/sha256"},
    "diagnostic_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "diagnostic_authorization_sha256": {"$ref": "#/$defs/sha256"},
    "diagnostic_approval_binding_sha256": {"$ref": "#/$defs/sha256"},
    "cohort_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "parent_gate_a_cohort_manifest_sha256": {"const": "ddcbc3d16c57cbc9c02268bccb01eee223f3aa3f502cdfa7e449e8171a759e1a"},
    "auth004_nonoverlap_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "auth004_intersection_count": {"const": 0},
    "exact_headline_denominator": {"const": 3},
    "target_bindings": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/target"}},
    "provider": {"const": "glm"},
    "request_model_id": {"const": "glm-5.2"},
    "api_surface": {"const": "chat.completions.create"},
    "endpoint_id": {"const": "glm_standard_v4"},
    "endpoint_sha256": {"$ref": "#/$defs/sha256"},
    "request_protocol_sha256": {"$ref": "#/$defs/sha256"},
    "initial_request_template_sha256": {"$ref": "#/$defs/sha256"},
    "tool_schema_sha256": {"$ref": "#/$defs/sha256"},
    "synthetic_tool_result_sha256": {"$ref": "#/$defs/sha256"},
    "provider_policy_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "provider_policy_accepted": {"const": true},
    "provider_tariff_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "provider_tariff_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "preflight_verdict_sha256": {"$ref": "#/$defs/sha256"},
    "credential_delivery_mode": {"const": "fixed_linux_ecs_one_time_file"},
    "credential_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "owner_account": {"const": "taka-wzx"},
    "owner_reconfirmed": {"const": true},
    "kill_switch_bound": {"const": true},
    "authorization_window_start_utc": {"$ref": "#/$defs/utc"},
    "authorization_window_end_utc": {"$ref": "#/$defs/utc"},
    "headline_logical_call_cap": {"const": 6},
    "headline_http_attempt_cap": {"const": 6},
    "headline_input_token_cap": {"const": 12000},
    "headline_output_token_cap": {"const": 768},
    "input_rate_microcny_per_million": {"const": 8000000},
    "cached_input_rate_microcny_per_million": {"const": 2000000},
    "output_rate_microcny_per_million": {"const": 28000000},
    "headline_budget_microcny": {"const": 117504},
    "aggregate_remaining_microcny": {"const": 14960832},
    "aggregate_remaining_after_reservation_microcny": {"const": 14843328},
    "sdk_retries": {"const": 0},
    "transport_retries": {"const": 0},
    "concurrency": {"const": 1},
    "stop_policy": {"const": "stop_on_first_noncompleted_or_unknown_or_ambiguous"},
    "local_raw_retention": {"const": false},
    "stop_policy_sha256": {"$ref": "#/$defs/sha256"},
    "live_execution_enabled": {"const": true}
  }
}
