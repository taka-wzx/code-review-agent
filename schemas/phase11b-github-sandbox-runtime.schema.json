{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-agent.invalid/schemas/phase11b-github-sandbox-runtime.schema.json",
  "title": "CRAG GitHub sandbox canary runtime v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "synthetic_input_only",
    "real_github_writes_enabled",
    "real_model_calls",
    "real_business_repository_writes",
    "business_claim_allowed",
    "quality_claim_allowed",
    "production_ready",
    "executable_code_sha",
    "image_id",
    "source_archive_sha256",
    "deployment_config_sha256",
    "runtime_host_sha256",
    "runtime_environment",
    "github_api_url",
    "egress_allowlist",
    "tls_verify",
    "follow_redirects",
    "credential_injection_mode",
    "request_timeout_seconds",
    "canary_window_seconds",
    "approval_ttl_seconds",
    "max_retries",
    "backoff_seconds",
    "max_requests",
    "max_mutations",
    "max_reads",
    "max_branches",
    "max_commits",
    "max_draft_prs",
    "cost_ceiling_micro_cny",
    "repository_owner",
    "repository_name",
    "repository_id",
    "github_app_id",
    "installation_id",
    "installation_account_id",
    "base_branch",
    "base_sha",
    "base_tree_sha",
    "base_tree_manifest_complete",
    "base_tree_entries",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "crag.github-sandbox-runtime/v1alpha1"},
    "environment": {"const": "github_sandbox_canary"},
    "synthetic_input_only": {"const": true},
    "real_github_writes_enabled": {"const": true},
    "real_model_calls": {"const": false},
    "real_business_repository_writes": {"const": false},
    "business_claim_allowed": {"const": false},
    "quality_claim_allowed": {"const": false},
    "production_ready": {"const": false},
    "executable_code_sha": {"$ref": "#/$defs/gitSha"},
    "image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_archive_sha256": {"$ref": "#/$defs/sha256"},
    "deployment_config_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_host_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_environment": {"const": "aliyun_ecs_cn_hangzhou"},
    "github_api_url": {"const": "https://api.github.com"},
    "egress_allowlist": {
      "type": "array",
      "prefixItems": [{"const": "api.github.com:443"}],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "tls_verify": {"const": true},
    "follow_redirects": {"const": false},
    "credential_injection_mode": {"const": "secure_explicit_json_file"},
    "request_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 10},
    "canary_window_seconds": {"type": "integer", "minimum": 1, "maximum": 2700},
    "approval_ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 1800},
    "max_retries": {"const": 0},
    "backoff_seconds": {"const": 0},
    "max_requests": {"const": 40},
    "max_mutations": {"const": 15},
    "max_reads": {"const": 25},
    "max_branches": {"const": 3},
    "max_commits": {"const": 3},
    "max_draft_prs": {"const": 3},
    "cost_ceiling_micro_cny": {"const": 0},
    "repository_owner": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"},
    "repository_name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}$"},
    "repository_id": {"type": "integer", "minimum": 1},
    "github_app_id": {"type": "integer", "minimum": 1},
    "installation_id": {"type": "integer", "minimum": 1},
    "installation_account_id": {"type": "integer", "minimum": 1},
    "base_branch": {"$ref": "#/$defs/branch"},
    "base_sha": {"$ref": "#/$defs/gitSha"},
    "base_tree_sha": {"$ref": "#/$defs/gitSha"},
    "base_tree_manifest_complete": {"const": true},
    "base_tree_entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/treeEntry"}
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!.*(?:\\.\\.|//|/\\.|\\.lock$))(?:[A-Za-z0-9]|[A-Za-z0-9][A-Za-z0-9._/-]*[A-Za-z0-9])$"
    },
    "treeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "type", "sha"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,255}$"},
        "mode": {"enum": ["100644", "100755", "120000", "040000", "160000"]},
        "type": {"enum": ["blob", "tree", "commit"]},
        "sha": {"$ref": "#/$defs/gitSha"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "repair_job_id",
        "repair_repository_id",
        "repair_base_sha",
        "repair_diff_sha256",
        "head_branch",
        "app_idempotency_key",
        "synthetic_file_path",
        "synthetic_content_base64",
        "file_mode",
        "blob_sha",
        "commit_message",
        "commit_timestamp",
        "expected_tree_sha",
        "exact_commit_sha",
        "diff_sha256",
        "test_evidence_sha256",
        "durable_budget_sha256",
        "checkpoint_sha256",
        "title",
        "body_prefix",
        "title_marker_sha256",
        "body_marker_sha256",
        "publisher_payload_sha256"
      ],
      "properties": {
        "case_id": {"enum": ["normal", "crash_after_branch", "crash_after_draft_pr"]},
        "repair_job_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "repair_repository_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "repair_base_sha": {"$ref": "#/$defs/gitSha"},
        "repair_diff_sha256": {"$ref": "#/$defs/sha256"},
        "head_branch": {"$ref": "#/$defs/branch"},
        "app_idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128},
        "synthetic_file_path": {"type": "string", "pattern": "^crag-canary-[A-Za-z0-9._-]{1,243}$"},
        "synthetic_content_base64": {"type": "string", "minLength": 4, "maxLength": 5464, "contentEncoding": "base64"},
        "file_mode": {"enum": ["100644", "100755"]},
        "blob_sha": {"$ref": "#/$defs/gitSha"},
        "commit_message": {"type": "string", "minLength": 1, "maxLength": 256},
        "commit_timestamp": {"$ref": "#/$defs/utcSecond"},
        "expected_tree_sha": {"$ref": "#/$defs/gitSha"},
        "exact_commit_sha": {"$ref": "#/$defs/gitSha"},
        "diff_sha256": {"$ref": "#/$defs/sha256"},
        "test_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "durable_budget_sha256": {"$ref": "#/$defs/sha256"},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "title": {"type": "string", "minLength": 1, "maxLength": 256},
        "body_prefix": {"type": "string", "minLength": 1, "maxLength": 1024},
        "title_marker_sha256": {"$ref": "#/$defs/sha256"},
        "body_marker_sha256": {"$ref": "#/$defs/sha256"},
        "publisher_payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "utcSecond": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
