{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-agent.invalid/schemas/postgres-recovery-result.schema.json",
  "title": "CRAG Postgres recovery rehearsal result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_kind",
    "operation",
    "status",
    "plan_sha256",
    "rehearsal_id_sha256",
    "source_service_sha256",
    "target_service_sha256",
    "source_fence_receipt_sha256",
    "started_at_utc",
    "completed_at_utc",
    "duration_seconds",
    "rpo_target_seconds",
    "rpo_observed_seconds",
    "rpo_passed",
    "rto_target_seconds",
    "rto_passed",
    "source_inventory_sha256",
    "target_inventory_sha256",
    "backup_sha256",
    "command_count",
    "raw_output_retained",
    "credentials_retained"
  ],
  "properties": {
    "schema_version": {"const": "crag.postgres-recovery-result/v1"},
    "evidence_kind": {"enum": ["offline_fake", "operator_executed"]},
    "operation": {"enum": ["backup_restore", "failover"]},
    "status": {"const": "passed"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "rehearsal_id_sha256": {"$ref": "#/$defs/sha256"},
    "source_service_sha256": {"$ref": "#/$defs/sha256"},
    "target_service_sha256": {"$ref": "#/$defs/sha256"},
    "source_fence_receipt_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "started_at_utc": {"$ref": "#/$defs/utcSecond"},
    "completed_at_utc": {"$ref": "#/$defs/utcSecond"},
    "duration_seconds": {"type": "number", "minimum": 0, "maximum": 86400},
    "rpo_target_seconds": {"const": 900},
    "rpo_observed_seconds": {
      "oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]
    },
    "rpo_passed": {"oneOf": [{"type": "boolean"}, {"type": "null"}]},
    "rto_target_seconds": {"const": 1800},
    "rto_passed": {"const": true},
    "source_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "target_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "backup_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "command_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "raw_output_retained": {"const": false},
    "credentials_retained": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utcSecond": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
