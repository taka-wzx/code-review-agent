{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 11C Gate A blocking preflight verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase_id",
    "preflight_verdict_sha256",
    "candidate_artifact_hashes",
    "checks",
    "canary_allowed",
    "real_run_recommended_now",
    "blocking_reason_codes",
    "execution_status",
    "protocol_canary_status",
    "redaction_applied"
  ],
  "properties": {
    "schema_version": {"const": "phase11c-provider-canary-preflight/v1"},
    "phase_id": {"const": "phase11c-provider-canary-v1"},
    "preflight_verdict_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_artifact_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_sha256",
        "runtime_config_sha256",
        "cohort_manifest_sha256",
        "tariff_manifest_sha256",
        "budget_proposal_sha256",
        "executable_source_sha256",
        "sdk_package_set_sha256"
      ],
      "properties": {
        "authorization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cohort_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tariff_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "budget_proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "executable_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sdk_package_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "canary_allowed": {"const": false},
    "real_run_recommended_now": {"const": false},
    "blocking_reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
    },
    "execution_status": {"const": "not_run"},
    "protocol_canary_status": {"const": "not_run"},
    "redaction_applied": {"const": true}
  }
}
