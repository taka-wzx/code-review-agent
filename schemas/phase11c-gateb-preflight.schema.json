{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crag.invalid/schemas/phase11c-gateb-preflight.schema.json",
  "title": "Phase 11C execution preflight verdict v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "authorizationId": {"type": "string", "pattern": "^p11c-gateb-[0-9a-f]{32}$"}
  },
  "required": [
    "schema_version", "phase_id", "stage", "preflight_verdict_sha256", "execution_freeze_sha256", "freeze_subject_sha256",
    "authorization_id", "baseline", "policy_url", "retention_policy_url", "policy_reviewed_at_utc",
    "authorization_window_start_utc", "authorization_window_end_utc", "checks", "canary_allowed",
    "real_run_recommended_now", "blocking_reason_codes", "redaction_applied", "snapshot_immutability"
  ],
  "properties": {
    "schema_version": {"const": "phase11c-gateb-preflight/v1"},
    "phase_id": {"const": "phase11c-gateb-headline-cohort-executor-v1"},
    "stage": {"enum": ["DIAGNOSTIC", "HEADLINE_COHORT"]},
    "preflight_verdict_sha256": {"$ref": "#/$defs/sha256"},
    "execution_freeze_sha256": {"$ref": "#/$defs/sha256"},
    "freeze_subject_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_id": {"$ref": "#/$defs/authorizationId"},
    "baseline": {"type": "object"},
    "policy_url": {"type": "string", "pattern": "^https://"},
    "retention_policy_url": {"type": "string", "pattern": "^https://"},
    "policy_reviewed_at_utc": {"$ref": "#/$defs/utc"},
    "authorization_window_start_utc": {"$ref": "#/$defs/utc"},
    "authorization_window_end_utc": {"$ref": "#/$defs/utc"},
    "checks": {"type": "object", "additionalProperties": {"const": true}},
    "canary_allowed": {"const": true},
    "real_run_recommended_now": {"const": true},
    "blocking_reason_codes": {"type": "array", "maxItems": 0},
    "redaction_applied": {"const": true},
    "snapshot_immutability": {"const": false}
  }
}
