{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crag.invalid/schemas/phase11c-gateb-execution-freeze.schema.json",
  "title": "Phase 11C immutable execution freeze v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "authorizationId": {"type": "string", "pattern": "^p11c-gateb-[0-9a-f]{32}$"}
  },
  "required": [
    "schema_version", "phase_id", "stage", "execution_freeze_sha256", "freeze_subject_sha256", "authorization_id",
    "runtime_config_sha256", "provider_tariff_manifest_sha256", "bindings", "owners", "baseline",
    "credential_delivery_mode", "provider_policy_accepted", "owner_reconfirmed", "kill_switch_bound",
    "authorization_window_start_utc", "authorization_window_end_utc", "budget_microcny", "snapshot_immutability", "redaction_applied"
  ],
  "properties": {
    "schema_version": {"const": "phase11c-gateb-execution-freeze/v1"},
    "phase_id": {"const": "phase11c-gateb-headline-cohort-executor-v1"},
    "stage": {"enum": ["DIAGNOSTIC", "HEADLINE_COHORT"]},
    "execution_freeze_sha256": {"$ref": "#/$defs/sha256"},
    "freeze_subject_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_id": {"$ref": "#/$defs/authorizationId"},
    "runtime_config_sha256": {"$ref": "#/$defs/sha256"},
    "provider_tariff_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_config_sha256", "executable_commit_sha", "executable_source_sha256", "source_tree_sha256",
        "source_archive_sha256", "dockerfile_sha256", "compose_sha256", "image_sha256", "deployment_sha256",
        "runtime_identity_sha256", "cohort_manifest_sha256", "provider_policy_evidence_sha256",
        "provider_tariff_evidence_sha256", "provider_tariff_manifest_sha256", "credential_fingerprint_sha256"
      ],
      "properties": {
        "runtime_config_sha256": {"$ref": "#/$defs/sha256"},
        "executable_commit_sha": {"$ref": "#/$defs/commit"},
        "executable_source_sha256": {"$ref": "#/$defs/sha256"},
        "source_tree_sha256": {"$ref": "#/$defs/sha256"},
        "source_archive_sha256": {"$ref": "#/$defs/sha256"},
        "dockerfile_sha256": {"$ref": "#/$defs/sha256"},
        "compose_sha256": {"$ref": "#/$defs/sha256"},
        "image_sha256": {"$ref": "#/$defs/sha256"},
        "deployment_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_identity_sha256": {"$ref": "#/$defs/sha256"},
        "cohort_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "provider_policy_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "provider_tariff_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "provider_tariff_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "credential_fingerprint_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorization", "revocation", "kill_switch", "incident", "cleanup"],
      "properties": {
        "authorization": {"const": "taka-wzx"},
        "revocation": {"const": "taka-wzx"},
        "kill_switch": {"const": "taka-wzx"},
        "incident": {"const": "taka-wzx"},
        "cleanup": {"const": "taka-wzx"}
      }
    },
    "baseline": {"type": "object"},
    "credential_delivery_mode": {"const": "fixed_linux_ecs_one_time_file"},
    "provider_policy_accepted": {"const": true},
    "owner_reconfirmed": {"const": true},
    "kill_switch_bound": {"const": true},
    "authorization_window_start_utc": {"$ref": "#/$defs/utc"},
    "authorization_window_end_utc": {"$ref": "#/$defs/utc"},
    "budget_microcny": {"type": "integer", "minimum": 0},
    "snapshot_immutability": {"const": false},
    "redaction_applied": {"const": true}
  }
}
