{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crag.invalid/schemas/phase11c-gateb-protocol-diagnostic-authorization.schema.json",
  "title": "Phase 11C same-image diagnostic authorization v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "count": {"type": "integer", "minimum": 0}
  },
  "required": [
    "schema_version", "phase_id", "stage", "authorization_status", "authorization_sha256",
    "executable_source_sha256", "source_tree_sha256", "dockerfile_sha256", "compose_sha256",
    "image_sha256", "deployment_sha256", "runtime_identity_sha256", "provider", "request_model_id",
    "api_surface", "endpoint_id", "endpoint_sha256", "diagnostic_request_sha256",
    "provider_policy_evidence_sha256", "provider_policy_accepted", "provider_tariff_evidence_sha256",
    "credential_delivery_mode", "credential_fingerprint_sha256", "owner_account", "owner_reconfirmed",
    "kill_switch_bound", "authorization_window_start_utc", "authorization_window_end_utc", "max_logical_calls",
    "max_http_attempts", "max_input_tokens", "max_output_tokens", "input_rate_microcny_per_million",
    "cached_input_rate_microcny_per_million", "output_rate_microcny_per_million", "diagnostic_budget_microcny",
    "aggregate_remaining_microcny", "aggregate_remaining_after_reservation_microcny", "sdk_retries",
    "transport_retries", "concurrency", "local_raw_retention", "live_execution_enabled"
  ],
  "properties": {
    "schema_version": {"const": "phase11c-gateb-protocol-diagnostic-authorization/v1"},
    "phase_id": {"const": "phase11c-gateb-headline-cohort-executor-v1"},
    "stage": {"const": "DIAGNOSTIC"},
    "authorization_status": {"const": "frozen_pending_exact_approval"},
    "authorization_sha256": {"$ref": "#/$defs/sha256"},
    "executable_source_sha256": {"$ref": "#/$defs/sha256"},
    "source_tree_sha256": {"$ref": "#/$defs/sha256"},
    "dockerfile_sha256": {"$ref": "#/$defs/sha256"},
    "compose_sha256": {"$ref": "#/$defs/sha256"},
    "image_sha256": {"$ref": "#/$defs/sha256"},
    "deployment_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_identity_sha256": {"$ref": "#/$defs/sha256"},
    "provider": {"const": "glm"},
    "request_model_id": {"const": "glm-5.2"},
    "api_surface": {"const": "chat.completions.create"},
    "endpoint_id": {"const": "glm_standard_v4"},
    "endpoint_sha256": {"$ref": "#/$defs/sha256"},
    "diagnostic_request_sha256": {"$ref": "#/$defs/sha256"},
    "provider_policy_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "provider_policy_accepted": {"const": true},
    "provider_tariff_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "credential_delivery_mode": {"const": "fixed_linux_ecs_one_time_file"},
    "credential_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "owner_account": {"const": "taka-wzx"},
    "owner_reconfirmed": {"const": true},
    "kill_switch_bound": {"const": true},
    "authorization_window_start_utc": {"$ref": "#/$defs/utc"},
    "authorization_window_end_utc": {"$ref": "#/$defs/utc"},
    "max_logical_calls": {"const": 1},
    "max_http_attempts": {"const": 1},
    "max_input_tokens": {"const": 2000},
    "max_output_tokens": {"const": 128},
    "input_rate_microcny_per_million": {"const": 8000000},
    "cached_input_rate_microcny_per_million": {"const": 2000000},
    "output_rate_microcny_per_million": {"const": 28000000},
    "diagnostic_budget_microcny": {"const": 19584},
    "aggregate_remaining_microcny": {"const": 14980416},
    "aggregate_remaining_after_reservation_microcny": {"const": 14960832},
    "sdk_retries": {"const": 0},
    "transport_retries": {"const": 0},
    "concurrency": {"const": 1},
    "local_raw_retention": {"const": false},
    "live_execution_enabled": {"const": true}
  }
}
