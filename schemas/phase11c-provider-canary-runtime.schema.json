{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 11C provider runtime candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase_id",
    "runtime_config_sha256",
    "provider",
    "request_model_id",
    "snapshot_immutability",
    "api_surface",
    "base_url",
    "egress_allowlist",
    "tls_certificate_verification",
    "redirect_policy",
    "sdk_retries",
    "transport_retries",
    "concurrency",
    "proxy_policy",
    "openai_sdk_version",
    "sdk_package_set_sha256",
    "publisher_mode",
    "real_provider_calls_enabled",
    "paid_calls_enabled",
    "local_persistence",
    "executable_code_commit_sha",
    "executable_source_sha256",
    "immutable_image_digest",
    "source_archive_sha256",
    "rendered_deployment_config_sha256",
    "aliyun_runtime_identity_sha256"
  ],
  "properties": {
    "schema_version": {"const": "phase11c-provider-canary-runtime/v1"},
    "phase_id": {"const": "phase11c-provider-canary-v1"},
    "runtime_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider": {"const": "glm"},
    "request_model_id": {"const": "glm-5.2"},
    "snapshot_immutability": {"const": false},
    "api_surface": {"const": "chat.completions.create"},
    "base_url": {"const": "https://open.bigmodel.cn/api/paas/v4"},
    "egress_allowlist": {"const": "open.bigmodel.cn:443"},
    "tls_certificate_verification": {"const": true},
    "redirect_policy": {"const": "deny"},
    "sdk_retries": {"const": 0},
    "transport_retries": {"const": 0},
    "concurrency": {"const": 1},
    "proxy_policy": {"const": "deny_implicit_inheritance"},
    "openai_sdk_version": {"const": "2.46.0"},
    "sdk_package_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publisher_mode": {"const": "fake_dry_run"},
    "real_provider_calls_enabled": {"const": false},
    "paid_calls_enabled": {"const": false},
    "local_persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rendered_raw_prompt_retention",
        "rendered_synthetic_diff_retention",
        "raw_provider_response_retention",
        "raw_tool_args_results_retention",
        "exception_message_retention",
        "credential_value_retention",
        "deterministic_synthetic_source_manifest_retention",
        "safe_hash_enum_boolean_count_receipt_retention"
      ],
      "properties": {
        "rendered_raw_prompt_retention": {"const": false},
        "rendered_synthetic_diff_retention": {"const": false},
        "raw_provider_response_retention": {"const": false},
        "raw_tool_args_results_retention": {"const": false},
        "exception_message_retention": {"const": false},
        "credential_value_retention": {"const": false},
        "deterministic_synthetic_source_manifest_retention": {"const": true},
        "safe_hash_enum_boolean_count_receipt_retention": {"const": true}
      }
    },
    "executable_code_commit_sha": {"const": "PENDING_EXECUTABLE_COMMIT"},
    "executable_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "immutable_image_digest": {"const": "PENDING_FREEZE"},
    "source_archive_sha256": {"const": "PENDING_FREEZE"},
    "rendered_deployment_config_sha256": {"const": "PENDING_FREEZE"},
    "aliyun_runtime_identity_sha256": {"const": "PENDING_FREEZE"}
  }
}
