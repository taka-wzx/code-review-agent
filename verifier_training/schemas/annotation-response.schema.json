{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-agent.local/schemas/verifier-training/annotation-response-v1.json",
  "title": "Phase 8D human response row",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "label", "rationale", "created_at"],
  "properties": {
    "candidate_id": {
      "type": "string", "minLength": 1, "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/#-]{0,199}$"
    },
    "label": {"enum": ["keep", "drop", "uncertain"]},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 4000},
    "created_at": {
      "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
