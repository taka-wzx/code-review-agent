{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-agent.local/schemas/verifier-training/finder-run-v1.json",
  "title": "Phase 8D Finder execution receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "queue_id", "queue_sha256", "source_id",
    "pr_source_sha256", "diff_sha256", "status", "candidate_ids",
    "candidate_count", "provider", "model", "prompt_sha256", "started_at",
    "finished_at", "input_tokens", "output_tokens", "cost_cny",
    "trace_sha256", "error_category", "synthetic", "run_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"$ref": "#/$defs/id"},
    "queue_id": {"$ref": "#/$defs/id"},
    "queue_sha256": {"$ref": "#/$defs/sha256"},
    "source_id": {"$ref": "#/$defs/id"},
    "pr_source_sha256": {"$ref": "#/$defs/sha256"},
    "diff_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["completed", "completed_zero_candidates", "failed"]},
    "candidate_ids": {
      "type": "array", "maxItems": 16, "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "candidate_count": {"type": "integer", "minimum": 0, "maximum": 16},
    "provider": {"$ref": "#/$defs/id"},
    "model": {"type": "string", "minLength": 1, "maxLength": 200},
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "started_at": {"$ref": "#/$defs/timestamp"},
    "finished_at": {"$ref": "#/$defs/timestamp"},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "cost_cny": {"type": "number", "minimum": 0},
    "trace_sha256": {"$ref": "#/$defs/sha256"},
    "error_category": {
      "oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
    },
    "synthetic": {"type": "boolean"},
    "run_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string", "minLength": 1, "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/#-]{0,199}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
