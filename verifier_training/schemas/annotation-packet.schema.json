{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-agent.local/schemas/verifier-training/annotation-packet-v1.json",
  "title": "Phase 8D blinded annotation or adjudication packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "packet_id", "mode", "reviewer_id", "created_at",
    "rubric_sha256", "candidate_set_sha256", "order_seed", "synthetic", "items",
    "packet_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "packet_id": {"$ref": "#/$defs/id"},
    "mode": {"enum": ["independent", "adjudication"]},
    "reviewer_id": {"$ref": "#/$defs/id"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "rubric_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_set_sha256": {"$ref": "#/$defs/sha256"},
    "order_seed": {"type": "integer"},
    "synthetic": {"type": "boolean"},
    "items": {
      "type": "array", "minItems": 1, "maxItems": 480,
      "items": {"$ref": "#/$defs/item"}
    },
    "packet_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string", "minLength": 1, "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/#-]{0,199}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "source_annotation": {
      "type": "object", "additionalProperties": false,
      "required": ["annotation_id", "annotation_sha256", "annotator_id", "label", "rationale"],
      "properties": {
        "annotation_id": {"$ref": "#/$defs/id"},
        "annotation_sha256": {"$ref": "#/$defs/sha256"},
        "annotator_id": {"$ref": "#/$defs/id"},
        "label": {"enum": ["keep", "drop", "uncertain"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": [
        "candidate_id", "candidate_source_sha256", "evidence_sha256",
        "repository_id", "source_id", "source_revision", "candidate_text",
        "evidence", "tool_summaries", "language", "severity",
        "source_annotations"
      ],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/id"},
        "candidate_source_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "repository_id": {"$ref": "#/$defs/id"},
        "source_id": {"$ref": "#/$defs/id"},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "candidate_text": {"type": "string", "minLength": 1, "maxLength": 8000},
        "evidence": {"type": "array", "maxItems": 8},
        "tool_summaries": {"type": "array", "maxItems": 8},
        "language": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "severity": {"enum": ["low", "medium", "high", null]},
        "source_annotations": {
          "type": "array", "maxItems": 2,
          "items": {"$ref": "#/$defs/source_annotation"}
        }
      }
    }
  }
}
