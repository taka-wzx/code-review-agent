ARG PYTHON_VERSION=3.13
FROM python:${PYTHON_VERSION}-slim

ARG DEBIAN_MIRROR=https://deb.debian.org
ARG PYPI_INDEX_URL=https://pypi.org/simple

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CRAG_SERVICE_HOST=0.0.0.0 \
    CRAG_SERVICE_PORT=8000 \
    CRAG_STATE_DIR=/var/lib/crag/state \
    CRAG_JOB_DATA_DIR=/var/lib/crag/jobs \
    CRAG_TRACE_DIR=/var/lib/crag/traces

WORKDIR /app

RUN case "$DEBIAN_MIRROR" in \
        https://deb.debian.org|https://mirrors.aliyun.com) ;; \
        *) echo "unsupported DEBIAN_MIRROR" >&2; exit 64 ;; \
    esac \
    && case "$PYPI_INDEX_URL" in \
        https://pypi.org/simple|https://mirrors.aliyun.com/pypi/simple/) ;; \
        *) echo "unsupported PYPI_INDEX_URL" >&2; exit 64 ;; \
    esac \
    && sed -i \
        -e "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" \
        -e "s|https://deb.debian.org|${DEBIAN_MIRROR}|g" \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=5 update \
    && apt-get install --yes --no-install-recommends ca-certificates git util-linux \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml requirements.lock README.md LICENSE ./
COPY alembic.ini ./
COPY migrations ./migrations
COPY src ./src

RUN python -m pip install --index-url "$PYPI_INDEX_URL" -r requirements.lock \
    && python -m pip install --index-url "$PYPI_INDEX_URL" . --no-deps \
    && groupadd --gid 1000 appuser \
    && useradd --uid 1000 --gid 1000 --create-home --shell /usr/sbin/nologin appuser \
    && mkdir -p /var/lib/crag/state /var/lib/crag/jobs /var/lib/crag/traces /synthetic/repository \
    && git init --quiet --initial-branch=main /synthetic/repository \
    && chown -R appuser:appuser /var/lib/crag /synthetic \
    && printf '%s\n' \
        '#!/bin/sh' \
        'set -eu' \
        'if [ "$(id -u)" -eq 0 ]; then' \
        '  secret_dir=/tmp/crag-secrets' \
        '  mkdir -p "$secret_dir"' \
        '  chown root:root "$secret_dir"' \
        '  chmod 0711 "$secret_dir"' \
        '  for variable in CRAG_DATABASE_PASSWORD_FILE CRAG_WEBHOOK_SECRET_FILE CRAG_SERVICE_TOKEN_FILE CRAG_CANARY_APPROVER_TOKEN_FILE CRAG_CANARY_GITHUB_TOKEN_FILE; do' \
        '    source=$(printenv "$variable" 2>/dev/null || true)' \
        '    [ -n "$source" ] || continue' \
        '    [ -f "$source" ] || continue' \
        '    target="$secret_dir/${variable%_FILE}"' \
        '    temporary="$target.$$"' \
        '    rm -f "$temporary"' \
        '    cp "$source" "$temporary"' \
        '    chmod 0600 "$temporary"' \
        '    chown appuser:appuser "$temporary"' \
        '    mv -f "$temporary" "$target"' \
        '    export "$variable=$target"' \
        '  done' \
        '  if [ "$#" -eq 0 ]; then set -- crag-service; elif [ "${1#-}" != "$1" ]; then set -- crag-service "$@"; fi' \
        '  exec setpriv --reuid=1000 --regid=1000 --init-groups --bounding-set=-all --inh-caps=-all --ambient-caps=-all -- "$@"' \
        'fi' \
        'exec "$@"' \
        > /usr/local/bin/crag-entrypoint \
    && chmod 0755 /usr/local/bin/crag-entrypoint

USER root

EXPOSE 8000
STOPSIGNAL SIGTERM
ENTRYPOINT ["crag-entrypoint"]
CMD ["crag-service"]
