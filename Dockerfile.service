ARG PYTHON_VERSION=3.13
FROM python:${PYTHON_VERSION}-slim

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CRAG_SERVICE_HOST=0.0.0.0 \
    CRAG_SERVICE_PORT=8000 \
    CRAG_STATE_DIR=/var/lib/crag/state \
    CRAG_JOB_DATA_DIR=/var/lib/crag/jobs \
    CRAG_TRACE_DIR=/var/lib/crag/traces

WORKDIR /app

RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=5 update \
    && apt-get install --yes --no-install-recommends ca-certificates gh git \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml requirements.lock README.md LICENSE ./
COPY alembic.ini ./
COPY migrations ./migrations
COPY src ./src

RUN python -m pip install -r requirements.lock \
    && python -m pip install . --no-deps \
    && useradd --create-home --shell /usr/sbin/nologin appuser \
    && mkdir -p /var/lib/crag/state /var/lib/crag/jobs /var/lib/crag/traces \
    && chown -R appuser:appuser /var/lib/crag

USER appuser

EXPOSE 8000
STOPSIGNAL SIGTERM
ENTRYPOINT ["crag-service"]
