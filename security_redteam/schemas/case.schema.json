{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-agent.invalid/schemas/week6/security-case.schema.json",
  "title": "Week 6 materialized deterministic security case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "kind",
    "family",
    "title",
    "risk_ids",
    "platforms",
    "matching_ids",
    "plan_case_spec_sha256",
    "implementation_source_commit",
    "seed",
    "entry_point",
    "preconditions",
    "fixture_refs",
    "requested_operation",
    "policy_rule",
    "expected_decision",
    "allowed_terminal_states",
    "expected_audit_events",
    "forbidden_effects",
    "canary_ids",
    "budgets",
    "cleanup_expectation",
    "materialized_hash_algorithm",
    "materialized_case_sha256"
  ],
  "properties": {
    "schema_version": {"const": "week6.security-case.v1"},
    "case_id": {"type": "string", "pattern": "^W6-(PI|TO|SE|PA|CE|RE|AU|TL|CTRL)-[0-9]{2}$"},
    "kind": {"enum": ["adversarial", "control"]},
    "family": {
      "enum": [
        "prompt_injection",
        "tool_output_injection",
        "secret_access",
        "path_aliasing",
        "command_execution",
        "resource_exhaustion",
        "authorization",
        "trace_export"
      ]
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "risk_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^ASI(0[1-9]|10)$"}
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["all-fake", "windows-fake", "linux-fake"]}
    },
    "matching_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^W6-(PI|TO|SE|PA|CE|RE|AU|TL|CTRL)-[0-9]{2}$"}
    },
    "plan_case_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "implementation_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "seed": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry_point": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{2,95}$"},
    "preconditions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"}
    },
    "fixture_refs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(fixture|fake-boundary)://week6/[a-z0-9_/-]+$"}
    },
    "requested_operation": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,95}$"},
    "policy_rule": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,95}$"},
    "expected_decision": {
      "enum": ["inert", "denied", "bounded", "quarantined", "sanitized", "degraded", "allowed"]
    },
    "allowed_terminal_states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}
    },
    "expected_audit_events": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{2,95}$"}
    },
    "forbidden_effects": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}
    },
    "canary_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"const": "case-local-generated-canary"}
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_ms",
        "host_process_starts",
        "recording_executor_calls",
        "output_bytes",
        "tool_attempts",
        "network_attempts",
        "host_credential_reads"
      ],
      "properties": {
        "wall_time_ms": {"type": "integer", "minimum": 1, "maximum": 2000},
        "host_process_starts": {"const": 0},
        "recording_executor_calls": {"type": "integer", "minimum": 1, "maximum": 8},
        "output_bytes": {"type": "integer", "minimum": 1, "maximum": 16384},
        "tool_attempts": {"type": "integer", "minimum": 1, "maximum": 8},
        "network_attempts": {"const": 0},
        "host_credential_reads": {"const": 0}
      }
    },
    "cleanup_expectation": {
      "enum": ["no-protected-side-effect", "quarantine-and-remove-fake-mutation"]
    },
    "materialized_hash_algorithm": {
      "const": "sha256-utf8-json-sort-keys-compact-without-materialized_case_sha256"
    },
    "materialized_case_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
