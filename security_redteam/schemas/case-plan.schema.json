{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review-agent.invalid/schemas/week6/case-plan.schema.json",
  "title": "Week 6 frozen red-team case plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "frozen_at",
    "phase0_commit",
    "materialized",
    "case_hash_algorithm",
    "case_counts",
    "default_budgets",
    "cases",
    "phase3_materialization_authorized",
    "docker_authorized",
    "external_model_authorized",
    "paid_evaluation_authorized"
  ],
  "properties": {
    "schema_version": {"const": "week6.case-plan.v1"},
    "contract_id": {"const": "week6-security-observability"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "phase0_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "materialized": {"const": false},
    "case_hash_algorithm": {"const": "sha256-utf8-json-sort-keys-compact-of-case-without-case_spec_sha256"},
    "case_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adversarial", "control", "total"],
      "properties": {
        "adversarial": {"const": 36},
        "control": {"const": 12},
        "total": {"const": 48}
      }
    },
    "default_budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_ms",
        "host_process_starts",
        "recording_executor_calls",
        "output_bytes",
        "tool_attempts",
        "network_attempts",
        "host_credential_reads"
      ],
      "properties": {
        "wall_time_ms": {"type": "integer", "minimum": 1, "maximum": 2000},
        "host_process_starts": {"const": 0},
        "recording_executor_calls": {"type": "integer", "minimum": 1, "maximum": 8},
        "output_bytes": {"type": "integer", "minimum": 1, "maximum": 16384},
        "tool_attempts": {"type": "integer", "minimum": 1, "maximum": 8},
        "network_attempts": {"const": 0},
        "host_credential_reads": {"const": 0}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {"$ref": "#/$defs/case"}
    },
    "phase3_materialization_authorized": {"const": false},
    "docker_authorized": {"const": false},
    "external_model_authorized": {"const": false},
    "paid_evaluation_authorized": {"const": false}
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "kind",
        "family",
        "title",
        "primary_risk_ids",
        "expected_outcome",
        "platforms",
        "matching_ids",
        "forbidden_effects",
        "case_spec_sha256"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^W6-(PI|TO|SE|PA|CE|RE|AU|TL|CTRL)-[0-9]{2}$"
        },
        "kind": {"enum": ["adversarial", "control"]},
        "family": {
          "enum": [
            "prompt_injection",
            "tool_output_injection",
            "secret_access",
            "path_aliasing",
            "command_execution",
            "resource_exhaustion",
            "authorization",
            "trace_export"
          ]
        },
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "primary_risk_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^ASI(0[1-9]|10)$"}
        },
        "expected_outcome": {
          "enum": ["inert", "denied", "bounded", "quarantined", "sanitized", "degraded", "allowed"]
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["all-fake", "windows-fake", "linux-fake"]}
        },
        "matching_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^W6-(PI|TO|SE|PA|CE|RE|AU|TL|CTRL)-[0-9]{2}$"
          }
        },
        "forbidden_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}
        },
        "case_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
