# Copy to .env (git-ignored) and fill in. Real environment variables win
# over .env values. Never commit the real file.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-key-here
# GLM_API_KEY=your-glm-key-here
# LLM_MODEL=override-model-id      # optional: pin a snapshot / try a model

# Week 7 service/MCP configuration. Use fresh random values; do not commit
# real tokens or webhook secrets. Paths must be absolute existing Git checkouts.
# CRAG_SERVICE_TOKEN=replace-with-at-least-32-random-bytes
# CRAG_WEBHOOK_SECRET=replace-with-at-least-16-random-bytes
# CRAG_REPOSITORIES_JSON={"owner/repository":"C:\\absolute\\checkout"}
# CRAG_STATE_DIR=C:\\absolute\\private-state
# CRAG_SERVICE_HOST=127.0.0.1
# CRAG_SERVICE_PORT=8000
# CRAG_SERVICE_WORKERS=2
# CRAG_ALLOWED_ORIGINS=http://127.0.0.1,http://localhost
# CRAG_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*
